# MemPalace central-Postgres environment.
# Copy to .env (compose) and/or export in the shell where the MCP server / CLI runs.

# ============================================================================
# CENTRAL SERVER (deploy/docker-compose.yml `mcp` service)
# ============================================================================
# Shared static bearer token gating the HTTP MCP server. REQUIRED to bring the
# stack up (compose fails fast if unset). Generate one and distribute it to the
# engineering org over a trusted channel: `openssl rand -hex 32`.
MEMPALACE_AUTH_TOKEN=change-me-shared-bearer-token  # pragma: allowlist secret
# Where the write-ahead audit log goes. The `mcp` service sets this to
# `postgres` (central audit table); flip to `jsonl` for a local-only trail.
# MEMPALACE_WAL_SINK=postgres

# ============================================================================
# PER-MACHINE CLIENT (CLI / a local MCP launcher pointed at the server)
# ============================================================================
# --- Select the Postgres backend (default is local chroma) ---
MEMPALACE_BACKEND=postgres

# --- Primary team vault for THIS machine ---
# This is what makes Claude Code default to your team's vault. Engineering teams
# only, e.g. frontend, backend, platform, data. Lowercased; [a-z0-9_] only.
MEMPALACE_TEAM=frontend

# --- Connection to the central PostgreSQL ---
# Either set a single URL...
# MEMPALACE_DATABASE_URL=postgresql://mempalace:mempalace@db-host:5432/mempalace
# ...or the discrete parts (URL wins if both are set):
MEMPALACE_PG_HOST=localhost
MEMPALACE_PG_PORT=5432
MEMPALACE_PG_DB=mempalace
MEMPALACE_PG_USER=mempalace
MEMPALACE_PG_PASSWORD=mempalace  # pragma: allowlist secret

# Client-side connection pool ceiling. Keep small so N engineers sharing one
# central server do not exhaust max_connections (100). ~5 per machine is plenty.
MEMPALACE_PG_POOL_MAX=5
