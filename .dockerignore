# Build context trim for deploy/server/Dockerfile (compose builds from repo root).
# The wheel only packages the `mempalace/` dir (see pyproject hatch config), so
# everything below is safe to exclude — it keeps the context small and, for
# deploy/, avoids shipping a local .env (and its bearer token) into the image.
.git
.venv
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
*.egg-info
.omc
deploy
# Re-include ONLY the pip constraints file the server Dockerfile consumes —
# deploy/ stays excluded so a local deploy/.env (bearer token) never enters
# the image.
!deploy/server/constraints.txt
tests
benchmarks
